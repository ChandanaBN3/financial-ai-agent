# Server Configuration
PORT=5000
NODE_ENV=development

# Optional LLM API Key (Google Gemini)
# Leave blank to run 100% locally with deterministic rule-based agents
# System runs completely offline and free without this key!
GEMINI_API_KEY=

# Local Knowledge Base Path (default points to server/data/knowledge)
KNOWLEDGE_PATH=./data/knowledge

# SQLite Database Path (default points to server/data/financial_agent.db)
DATABASE_PATH=./data/financial_agent.db
